# ==========================================
# Review Management SaaS - Frontend Environment
# ==========================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# CRITICAL SECURITY RULE:
# Any variable prefixed with NEXT_PUBLIC_ is bundled into client-side JavaScript
# and is completely visible to any browser inspector.
# NEVER place server secrets, API private keys, database passwords, or session secrets here.

# Backend API v1 Base URL (Pointing to the local Express backend on port 5050)
NEXT_PUBLIC_API_URL=http://localhost:5050/api/v1
